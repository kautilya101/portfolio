---
import Stamp from '../newspaper/Stamp.astro';
import type { Site } from '../../lib/types';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const headline = site.contactHeadline.length ? site.contactHeadline : ['Looking for a', `${site.role.toLowerCase()}?`];
const links = [
  site.email && { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  site.github && { label: 'GitHub', value: site.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: site.github, external: true },
  site.linkedin && { label: 'LinkedIn', value: site.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: site.linkedin, external: true },
  site.resume && { label: 'Resume', value: 'Download the full record', href: site.resume, external: true }
].filter(Boolean) as { label: string; value: string; href: string; external: boolean }[];
---

<section class="section sheet contact" id="contact" aria-labelledby="contact-title">
  <div class="rule rule--heavy" data-reveal-rule aria-hidden="true"></div>
  <div class="contact__top" data-reveal>
    <span class="kicker kicker--rust">Final Edition</span>
    <span class="kicker">Last page · Late city</span>
  </div>
  <div class="contact__grid">
    <div class="contact__headline">
      <h2 class="display display--lg" id="contact-title" data-reveal>
        {headline.map((line) => <span class="contact__line">{line}</span>)}
      </h2>
      <p class="contact__sub dek" data-reveal>Let's build<br />something useful.</p>
      <div class="contact__stamp" data-reveal>
        <Stamp label="Reply requested" rotate={-5} />
      </div>
    </div>
    <ul class="contact__links" role="list">
      {
        links.map((link) => (
          <li data-reveal>
            <a href={link.href} class="contact__link" {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="kicker kicker--rust">{link.label}</span>
              <span class="contact__value">{link.value}</span>
              <span class="contact__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0 clamp(24px, 4vw, 48px);
  }

  .contact__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr);
  }

  .contact__line {
    display: block;
  }

  .contact__sub {
    margin-top: 22px;
    color: var(--rust);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.02;
  }

  .contact__stamp {
    margin-top: 28px;
  }

  .contact__links {
    padding: 0;
    align-self: end;
    border-top: var(--rule);
  }

  .contact__link {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: var(--rule-faint);
    text-decoration: none;
    transition: padding 0.45s var(--ease-out), background-color 0.4s var(--ease-paper);
  }

  .contact__value {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.9rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    font-family: var(--font-mono);
    color: var(--rust);
    transition: translate 0.45s var(--ease-out);
  }

  .contact__link:hover {
    padding-left: 10px;
    background-color: rgba(229, 219, 193, 0.45);
  }

  .contact__link:hover .contact__arrow {
    translate: 6px 0;
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--col-gap);
    }
  }

  @media (max-width: 520px) {
    .contact__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 12px;
    }

    .contact__link .kicker {
      grid-column: 1 / -1;
    }
  }
</style>
