---
import Caption from './Caption.astro';
import Plate, { type PlateVariant } from './Plate.astro';
import { hasImage, imageDimensions, imageSrcSet, imageUrl } from '../../lib/sanity';
import type { SanityImage } from '../../lib/types';

interface Props {
  image?: SanityImage | null;
  alt?: string;
  fig?: string;
  caption?: string;
  ratio?: number;
  sizes?: string;
  priority?: boolean;
  tilt?: 'l' | 'r' | null;
  reveal?: boolean;
  parallax?: boolean;
  placeholder?: PlateVariant;
  class?: string;
  load?: number;
  crop?: boolean;
  colorHover?: boolean;
}

const {
  image,
  alt,
  fig,
  caption,
  ratio: forcedRatio,
  sizes = '(min-width: 900px) 50vw, 100vw',
  priority = false,
  tilt = null,
  reveal = true,
  parallax = true,
  placeholder = 'browser',
  class: className,
  load,
  crop = false,
  colorHover = false
} = Astro.props;

const present = hasImage(image);
const cropRatio = present && crop ? forcedRatio : undefined;
const dims = present ? imageDimensions(image, forcedRatio ?? 4 / 3) : null;
const ratio = present ? (cropRatio ?? dims!.ratio) : (forcedRatio ?? (placeholder === 'portrait' ? 4 / 5 : 4 / 3));
const lqip = present ? image.asset?.metadata?.lqip : undefined;
const width = 1200;
const height = Math.round(width / ratio);
const src = present ? imageUrl(image, width, cropRatio ? height : undefined) : '';
const srcset = present ? imageSrcSet(image, cropRatio) : '';
const fitted = present && !cropRatio;
const altText = alt ?? image?.alt ?? caption ?? '';
const captionText = caption ?? image?.caption;
---

<figure
  class:list={['figure', tilt && `figure--tilt-${tilt}`, colorHover && 'figure--color-hover', className]}
  data-reveal-img={reveal && load === undefined ? '' : undefined}
  data-load={load !== undefined ? 'plate' : undefined}
  style={load !== undefined ? `--i:${load}` : undefined}
>
  <div
    class:list={['figure__frame', 'halftone', fitted && 'figure__frame--fitted']}
    style={`aspect-ratio:${ratio.toFixed(4)};${lqip && !fitted ? `background-image:url(${lqip});background-size:cover;` : ''}`}
  >
    {
      present ? (
        <img
          src={src}
          srcset={srcset}
          sizes={sizes}
          width={width}
          height={height}
          alt={altText}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
          class:list={['figure__img', fitted && 'figure__img--fitted']}
        />
      ) : (
        <div class:list={['figure__plate', parallax && 'figure__img--parallax']} data-parallax={parallax ? '0.8' : undefined} data-parallax-mobile="off">
          <Plate variant={placeholder} label={altText || undefined} />
        </div>
      )
    }
  </div>
  <Caption fig={fig} text={captionText} />
</figure>

<style>
  .figure__img--parallax {
    position: absolute;
    left: 0;
    top: -20px;
    width: 100%;
    height: calc(100% + 40px);
  }

  .figure__frame--fitted {
    max-height: min(82vh, 960px);
    margin-inline: auto;
  }

  .figure__img--fitted {
    object-fit: contain;
  }

  .figure--color-hover .figure__img {
    transition:
      filter 0.7s var(--ease-paper),
      transform 0.9s var(--ease-out);
  }

  .figure--color-hover:hover .figure__img,
  .figure--color-hover:focus-within .figure__img {
    filter: none;
    transform: scale(1.05);
  }

  .figure--color-hover:hover .figure__frame::after,
  .figure--color-hover:focus-within .figure__frame::after {
    opacity: 0;
  }

  .figure__plate {
    width: 100%;
    height: 100%;
  }
</style>
