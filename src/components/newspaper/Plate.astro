---
export type PlateVariant = 'browser' | 'phone' | 'board' | 'terminal' | 'portrait';

interface Props {
  variant: PlateVariant;
  label?: string;
}

const { variant, label } = Astro.props;
const uid = `p${Math.random().toString(36).slice(2, 8)}`;
const viewBox = variant === 'portrait' ? '0 0 400 500' : '0 0 400 300';
const [, , w, h] = viewBox.split(' ').map(Number);
---

<svg class="plate" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" role="img" aria-label={label ?? `${variant} illustration`}>
  <defs>
    <pattern id={`${uid}-h`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="5" class="p-hatch" />
    </pattern>
    <pattern id={`${uid}-x`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
      <line x1="0" y1="0" x2="0" y2="6" class="p-hatch p-hatch--dense" />
      <line x1="3" y1="0" x2="3" y2="6" class="p-hatch p-hatch--dense" />
    </pattern>
    <pattern id={`${uid}-d`} width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" class="p-dot" />
    </pattern>
  </defs>

  <rect width={w} height={h} class="p-bg" />
  <rect width={w} height={h} fill={`url(#${uid}-h)`} opacity="0.55" />

  {
    variant === 'browser' && (
      <g>
        <rect x="46" y="42" width="308" height="222" class="p-paper p-stroke" />
        <rect x="46" y="42" width="308" height="24" class="p-ink" />
        <circle cx="60" cy="54" r="3.5" class="p-paper" />
        <circle cx="72" cy="54" r="3.5" class="p-paper" />
        <circle cx="84" cy="54" r="3.5" class="p-rust-fill" />
        <rect x="104" y="48" width="200" height="12" class="p-paper" opacity="0.85" />
        <rect x="64" y="82" width="86" height="164" fill={`url(#${uid}-x)`} class="p-stroke-thin" />
        <rect x="166" y="82" width="170" height="14" class="p-ink" />
        <rect x="166" y="104" width="120" height="6" class="p-muted" />
        <rect x="166" y="126" width="170" height="22" class="p-stroke" fill="none" />
        <rect x="166" y="158" width="170" height="22" class="p-stroke" fill="none" />
        <rect x="166" y="190" width="80" height="22" class="p-stroke" fill="none" />
        <rect x="256" y="190" width="80" height="22" class="p-stroke" fill={`url(#${uid}-d)`} />
        <rect x="166" y="224" width="68" height="20" class="p-rust-fill" />
        <line x1="172" y1="137" x2="240" y2="137" class="p-stroke-thin" />
        <line x1="172" y1="169" x2="220" y2="169" class="p-stroke-thin" />
      </g>
    )
  }

  {
    variant === 'phone' && (
      <g>
        <rect x="40" y="70" width="190" height="150" class="p-paper p-stroke" opacity="0.8" />
        <rect x="40" y="70" width="190" height="16" class="p-muted" />
        <rect x="56" y="100" width="100" height="10" class="p-ink" opacity="0.6" />
        <rect x="56" y="118" width="150" height="70" fill={`url(#${uid}-x)`} class="p-stroke-thin" />
        <rect x="214" y="34" width="132" height="244" rx="18" class="p-ink" />
        <rect x="224" y="52" width="112" height="208" rx="6" class="p-paper" />
        <rect x="262" y="40" width="36" height="5" rx="2.5" class="p-paper" opacity="0.5" />
        <rect x="234" y="64" width="70" height="10" class="p-ink" />
        <rect x="234" y="82" width="92" height="52" fill={`url(#${uid}-d)`} class="p-stroke-thin" />
        <rect x="234" y="144" width="92" height="18" class="p-stroke" fill="none" />
        <rect x="234" y="168" width="92" height="18" class="p-stroke" fill="none" />
        <rect x="234" y="192" width="92" height="18" class="p-stroke" fill="none" />
        <rect x="234" y="226" width="92" height="22" class="p-rust-fill" />
        <path d="M196 150 C206 146 208 140 214 138" class="p-rust-stroke" fill="none" />
      </g>
    )
  }

  {
    variant === 'board' && (
      <g>
        <rect x="34" y="36" width="332" height="228" class="p-paper p-stroke" />
        <line x1="145" y1="36" x2="145" y2="264" class="p-stroke-thin" />
        <line x1="256" y1="36" x2="256" y2="264" class="p-stroke-thin" />
        <rect x="50" y="56" width="80" height="54" class="p-paper p-stroke" transform="rotate(-2 90 83)" />
        <rect x="50" y="122" width="80" height="54" fill={`url(#${uid}-x)`} class="p-stroke" />
        <rect x="162" y="56" width="80" height="54" class="p-paper p-stroke" transform="rotate(1.5 202 83)" />
        <rect x="162" y="122" width="80" height="54" class="p-rust-fill" opacity="0.85" />
        <rect x="162" y="188" width="80" height="54" fill={`url(#${uid}-d)`} class="p-stroke" />
        <rect x="272" y="56" width="80" height="54" fill={`url(#${uid}-d)`} class="p-stroke" />
        <rect x="272" y="122" width="80" height="54" class="p-paper p-stroke" transform="rotate(-1 312 149)" />
        <path d="M118 196 l0 22 l6 -6 l8 12 l4 -2 l-8 -12 l9 0 z" class="p-ink" />
        <path d="M300 200 l0 22 l6 -6 l8 12 l4 -2 l-8 -12 l9 0 z" class="p-rust-fill" />
        <rect x="324" y="186" width="34" height="12" class="p-rust-fill" />
      </g>
    )
  }

  {
    variant === 'terminal' && (
      <g>
        <rect x="38" y="40" width="200" height="220" class="p-ink" />
        <rect x="52" y="60" width="18" height="6" class="p-rust-fill" />
        <rect x="76" y="60" width="96" height="6" class="p-paper" opacity="0.8" />
        <rect x="52" y="78" width="140" height="6" class="p-paper" opacity="0.45" />
        <rect x="52" y="96" width="110" height="6" class="p-paper" opacity="0.45" />
        <rect x="52" y="114" width="18" height="6" class="p-rust-fill" />
        <rect x="76" y="114" width="124" height="6" class="p-paper" opacity="0.8" />
        <rect x="52" y="132" width="160" height="6" class="p-paper" opacity="0.45" />
        <rect x="52" y="150" width="88" height="6" class="p-paper" opacity="0.45" />
        <rect x="52" y="168" width="18" height="6" class="p-rust-fill" />
        <rect x="76" y="168" width="10" height="10" class="p-paper" />
        <line x1="238" y1="100" x2="300" y2="80" class="p-stroke" />
        <line x1="238" y1="150" x2="310" y2="150" class="p-stroke" />
        <line x1="238" y1="200" x2="300" y2="222" class="p-stroke" />
        <circle cx="318" cy="76" r="22" class="p-paper p-stroke" />
        <circle cx="330" cy="150" r="22" fill={`url(#${uid}-x)`} class="p-stroke" />
        <circle cx="318" cy="226" r="22" class="p-rust-fill" />
        <circle cx="318" cy="76" r="6" class="p-ink" />
      </g>
    )
  }

  {
    variant === 'portrait' && (
      <g>
        <rect width="400" height="500" fill={`url(#${uid}-d)`} opacity="0.5" />
        <ellipse cx="200" cy="190" rx="84" ry="100" class="p-ink" opacity="0.9" />
        <ellipse cx="200" cy="198" rx="72" ry="88" fill={`url(#${uid}-x)`} />
        <path d="M60 500 C70 360 130 312 200 312 C270 312 330 360 340 500 Z" class="p-ink" opacity="0.92" />
        <path d="M130 500 C140 400 170 350 200 346 C230 350 260 400 270 500 Z" fill={`url(#${uid}-h)`} />
        <path d="M168 312 L200 372 L232 312" class="p-paper" opacity="0.8" />
        <rect x="170" y="280" width="60" height="40" class="p-ink" opacity="0.9" />
      </g>
    )
  }
</svg>

<style>
  .plate {
    width: 100%;
    height: 100%;
  }

  .p-bg {
    fill: var(--paper-dark);
  }

  .p-paper {
    fill: var(--paper-light);
  }

  .p-ink {
    fill: var(--ink);
  }

  .p-muted {
    fill: var(--ink-muted);
  }

  .p-rust-fill {
    fill: var(--rust);
  }

  .p-dot {
    fill: var(--ink);
    opacity: 0.55;
  }

  .p-hatch {
    stroke: var(--ink);
    stroke-width: 0.7;
    opacity: 0.35;
  }

  .p-hatch--dense {
    opacity: 0.6;
  }

  .p-stroke {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .p-stroke-thin {
    stroke: var(--ink);
    stroke-width: 0.9;
  }

  .p-rust-stroke {
    stroke: var(--rust);
    stroke-width: 1.6;
    stroke-dasharray: 4 3;
  }
</style>
