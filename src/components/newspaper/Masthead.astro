---
import { editionDate, issueNumber } from '../../lib/content';
import type { Site } from '../../lib/types';

interface Props {
  site: Site;
  compact?: boolean;
}

const { site, compact = false } = Astro.props;
const now = new Date();
const date = editionDate(now);
const issue = issueNumber(now);
const year = now.getFullYear();
const TitleTag = compact ? 'p' : 'h1';
---

<div class:list={['masthead', compact && 'masthead--compact']}>
  <div class="sheet">
    {
      !compact && (
        <div class="masthead__meta meta" data-load style="--i:0">
          <span>Issue No. {issue}</span>
          <span class="masthead__meta-center">Engineering / Software</span>
          <span>Vol. {year}</span>
        </div>
      )
    }
    <div class="rule rule--heavy" data-load="rule" style="--i:0" aria-hidden="true"></div>
    <TitleTag class="masthead__title" data-load style="--i:1">
      <a href="/" aria-label={`${site.publication} — home`}>{site.publication}</a>
    </TitleTag>
    <div class="masthead__strap meta" data-load style="--i:2">
      <span class="masthead__strap-side">{site.location ?? 'Printed on the web'}</span>
      <span class="masthead__tagline">{site.tagline}</span>
      <span class="masthead__strap-side masthead__strap-side--end">Since 2023</span>
    </div>
    <div class="rule rule--double" data-load="rule" style="--i:2" aria-hidden="true"></div>
  </div>
</div>

<style>
  .masthead {
    padding-top: clamp(14px, 2vw, 24px);
  }

  .masthead__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .masthead__title {
    padding: clamp(10px, 1.6vw, 20px) 0 clamp(6px, 1vw, 12px);
    font-family: var(--font-display);
    font-size: clamp(2rem, 8.9vw, 8.6rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    text-shadow: 0 0 1px rgba(33, 31, 26, 0.6), 0.4px 0.3px 0 rgba(33, 31, 26, 0.35);
  }

  .masthead__title a {
    text-decoration: none;
  }

  .masthead__strap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 10px 0;
    font-size: 0.7rem;
    border-top: var(--rule);
  }

  .masthead__tagline {
    text-align: center;
    letter-spacing: 0.22em;
    font-weight: 500;
  }

  .masthead__strap-side {
    color: var(--ink-muted);
  }

  .masthead__strap-side--end {
    text-align: right;
  }

  .masthead--compact .masthead__title {
    font-size: clamp(1.9rem, 5vw, 3.6rem);
    padding: 12px 0 8px;
  }

  @media (max-width: 767px) {
    .masthead__meta-center {
      display: none;
    }

    .masthead__strap {
      grid-template-columns: 1fr;
      gap: 4px;
      text-align: center;
    }

    .masthead__strap-side,
    .masthead__strap-side--end {
      text-align: center;
    }

    .masthead__strap-side:first-child {
      display: none;
    }

    .masthead__tagline {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
    }
  }
</style>
