---
import type { Experience, Surface } from '../../lib/types';

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
const surfaces: { key: Surface; label: string }[] = [
  { key: 'web', label: 'Web' },
  { key: 'mobile', label: 'Mobile' },
  { key: 'api', label: 'API' },
  { key: 'data', label: 'Data' },
  { key: 'ai', label: 'AI' }
];
const ledger = surfaces
  .map((s) => ({ ...s, companies: experience.filter((e) => e.surfaces.includes(s.key)).map((e) => e.company) }))
  .filter((s) => s.companies.length);
---

<figure class="wm" aria-labelledby="wm-title">
  <div class="wm__head" data-reveal>
    <p class="kicker kicker--rust">Fig. 02 — Engineering range</p>
    <p class="wm__title display display--sm" id="wm-title">One engineer.<br />Multiple surfaces.</p>
  </div>

  <div class="wm__plate" data-draw-group>
    <svg viewBox="0 0 320 420" role="img" aria-label="Diagram: web app and mobile app both connect to one API, which connects to data.">
      <defs>
        <pattern id="wm-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="5" class="wm-hatch" />
        </pattern>
        <marker id="wm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" class="wm-ink" />
        </marker>
      </defs>

      <text x="160" y="20" class="wm-label" text-anchor="middle">The user</text>
      <path d="M160 28 V44 M160 44 H80 V62 M160 44 H240 V62" class="wm-line" data-draw style="--len:260;--d:.1s" marker-end="url(#wm-arrow)" />

      <g class="wm-box">
        <rect x="22" y="66" width="116" height="100" class="wm-paper wm-stroke" />
        <rect x="22" y="66" width="116" height="100" fill="url(#wm-hatch)" opacity="0.5" />
        <rect x="38" y="82" width="84" height="56" class="wm-paper wm-stroke-thin" />
        <rect x="38" y="82" width="84" height="9" class="wm-ink" />
        <rect x="46" y="100" width="44" height="5" class="wm-muted" />
        <rect x="46" y="110" width="66" height="3" class="wm-muted" opacity="0.6" />
        <rect x="46" y="118" width="58" height="3" class="wm-muted" opacity="0.6" />
        <text x="80" y="156" class="wm-name" text-anchor="middle">Web app</text>
      </g>

      <g class="wm-box">
        <rect x="182" y="66" width="116" height="100" class="wm-paper wm-stroke" />
        <rect x="182" y="66" width="116" height="100" fill="url(#wm-hatch)" opacity="0.5" />
        <rect x="222" y="76" width="36" height="64" rx="6" class="wm-ink" />
        <rect x="226" y="84" width="28" height="48" rx="2" class="wm-paper" />
        <rect x="230" y="90" width="20" height="4" class="wm-muted" />
        <rect x="230" y="98" width="20" height="14" class="wm-rust" />
        <rect x="230" y="116" width="20" height="3" class="wm-muted" opacity="0.6" />
        <text x="240" y="156" class="wm-name" text-anchor="middle">Mobile app</text>
      </g>

      <path d="M80 166 V196 H150 V214" class="wm-line" data-draw style="--len:190;--d:.35s" marker-end="url(#wm-arrow)" />
      <path d="M240 166 V196 H170 V214" class="wm-line" data-draw style="--len:190;--d:.35s" marker-end="url(#wm-arrow)" />

      <g class="wm-box">
        <rect x="70" y="218" width="180" height="64" class="wm-ink" />
        <text x="160" y="246" class="wm-name wm-name--light" text-anchor="middle">API</text>
        <text x="160" y="266" class="wm-small wm-small--light" text-anchor="middle">Auth · Services · Jobs</text>
      </g>

      <path d="M160 282 V316" class="wm-line" data-draw style="--len:40;--d:.6s" marker-end="url(#wm-arrow)" />

      <g class="wm-box">
        <ellipse cx="160" cy="330" rx="62" ry="12" class="wm-paper wm-stroke" />
        <path d="M98 330 V384 A62 12 0 0 0 222 384 V330" class="wm-paper wm-stroke" />
        <path d="M98 330 V384 A62 12 0 0 0 222 384 V330" fill="url(#wm-hatch)" opacity="0.6" />
        <ellipse cx="160" cy="330" rx="62" ry="12" class="wm-paper wm-stroke" />
        <text x="160" y="370" class="wm-name" text-anchor="middle">Data</text>
      </g>

      <text x="6" y="118" class="wm-side" transform="rotate(-90 6 118)" text-anchor="middle">Frontend</text>
      <text x="6" y="300" class="wm-side" transform="rotate(-90 6 300)" text-anchor="middle">Backend</text>
      <path d="M14 66 V166 M14 218 V392" class="wm-rust-line" data-draw style="--len:280;--d:.8s" />
    </svg>
  </div>

  {
    ledger.length > 0 && (
      <table class="wm__ledger" data-reveal>
        <caption class="kicker">Surfaces on record</caption>
        <tbody>
          {ledger.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.companies.join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</figure>

<style>
  .wm {
    display: grid;
    gap: 22px;
    margin: 0;
  }

  .wm__title {
    margin-top: 8px;
    line-height: 0.98;
  }

  .wm__plate {
    padding: 18px 12px;
    border: 1px solid var(--ink);
    outline: 3px double var(--ink);
    outline-offset: 5px;
    background: rgba(229, 219, 193, 0.45);
  }

  .wm__plate svg {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    overflow: visible;
  }

  .wm-hatch {
    stroke: var(--ink);
    stroke-width: 0.6;
    opacity: 0.4;
  }

  .wm-ink {
    fill: var(--ink);
  }

  .wm-paper {
    fill: var(--paper-light);
  }

  .wm-muted {
    fill: var(--ink-muted);
  }

  .wm-rust {
    fill: var(--rust);
  }

  .wm-stroke {
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .wm-stroke-thin {
    stroke: var(--ink);
    stroke-width: 0.9;
  }

  .wm-line {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }

  .wm-rust-line {
    fill: none;
    stroke: var(--rust);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .wm-label,
  .wm-side,
  .wm-small {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--ink-muted);
  }

  .wm-side {
    fill: var(--rust);
  }

  .wm-name {
    font-family: var(--font-display);
    font-size: 15px;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .wm-name--light,
  .wm-small--light {
    fill: var(--paper-light);
  }

  .wm-box {
    transition: translate 0.5s var(--ease-out);
  }

  .wm__plate:hover .wm-box:hover {
    translate: 0 -2px;
  }

  .wm__ledger {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wm__ledger caption {
    text-align: left;
    padding-bottom: 8px;
  }

  .wm__ledger th,
  .wm__ledger td {
    padding: 9px 0;
    border-top: var(--rule-faint);
    text-align: left;
    vertical-align: top;
  }

  .wm__ledger th {
    width: 34%;
    font-weight: 500;
    color: var(--rust);
  }

  .wm__ledger tr:first-child th,
  .wm__ledger tr:first-child td {
    border-top: var(--rule);
  }
</style>
