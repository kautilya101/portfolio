---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Stack from '../components/sections/Stack.astro';
import Lab from '../components/sections/Lab.astro';
import Contact from '../components/sections/Contact.astro';
import { getEdition } from '../lib/content';

const edition = await getEdition();
const { site, show, projects, experience } = edition;
---

<BaseLayout>
  <Hero edition={edition} />
  {show.about && <About site={site} />}
  {show.experience && <Experience experience={experience} />}
  {show.projects && <Projects projects={projects} limit={4} />}
  {show.stack && <Stack site={site} />}
  {show.lab && <Lab items={site.lab} />}
  {show.contact && <Contact site={site} />}
</BaseLayout>
